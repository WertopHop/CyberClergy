# CyberClergy environment template
#
# Copy this file to `.env` and fill in only the providers you actually use.
# Every provider is optional: a missing or empty key simply disables that
# provider, and the application keeps working with the rest.
#
# Never commit your real `.env` — it is ignored by git.

# ---------------------------------------------------------------------------
# OpenRouter — https://openrouter.ai/keys
# Free models end with the `:free` suffix.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# ---------------------------------------------------------------------------
# Google AI Studio (Gemini API) — https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Groq — https://console.groq.com/keys
# ---------------------------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Mistral AI — https://console.mistral.ai/api-keys
# ---------------------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# ---------------------------------------------------------------------------
# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
# Needs both the account ID (visible in the dashboard URL) and an API token
# with the "Workers AI" permission. Keep the `@cf/` prefix in the model name.
# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# ---------------------------------------------------------------------------
# NVIDIA NIM — https://build.nvidia.com/
# ---------------------------------------------------------------------------
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Together AI — https://api.together.ai/settings/api-keys
# Models ending in `-Free` are the free tier.
# ---------------------------------------------------------------------------
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# ---------------------------------------------------------------------------
# Cerebras — https://cloud.cerebras.ai/
# ---------------------------------------------------------------------------
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# ---------------------------------------------------------------------------
# DeepInfra — https://deepinfra.com/dash/api_keys
# ---------------------------------------------------------------------------
# DEEPINFRA_API_KEY=
# DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ---------------------------------------------------------------------------
# GitHub Models — https://github.com/settings/tokens
# A personal access token is enough; the free tier is per account.
# ---------------------------------------------------------------------------
# GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Ollama — https://ollama.com/download
# Runs on this machine: no key, no quota. Naming a model is what turns it on;
# the model must already be pulled (for example `ollama pull llama3.2`).
# ---------------------------------------------------------------------------
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Custom OpenAI-compatible gateway. Both the base URL and the model are
# required; the key is optional for a keyless local proxy.
# ---------------------------------------------------------------------------
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=
# CUSTOM_API_KEY=

# ---------------------------------------------------------------------------
# Application settings (all optional)
# ---------------------------------------------------------------------------
# Order in which providers are tried when no explicit order is requested.
# CC_PROVIDER_ORDER=openrouter,gemini,groq,mistral,cloudflare,nvidia,together,cerebras,deepinfra,github-models,ollama,custom
# CC_HTTP_TIMEOUT_SECS=60
# CC_MAX_RETRIES=2
# CC_DEFAULT_TEMPERATURE=0.8
# Reasoning models spend tokens on hidden reasoning before answering, so keep
# this budget generous.
# CC_DEFAULT_MAX_TOKENS=2048
# Prayers asked for in one request (1..5). Free tiers bill per request, so a
# batch of three costs a third of the requests for the same number of prayers.
# Each religion profile carries its own default; this overrides all of them.
# CC_BATCH=3

# Optional attribution headers for OpenRouter (shown on their dashboard).
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=CyberClergy

# ---------------------------------------------------------------------------
# Advanced: override API base URLs.
# Only needed behind a corporate proxy, a local mock server or a regional
# gateway. An empty value keeps the official endpoint.
# ---------------------------------------------------------------------------
# OPENROUTER_BASE_URL=
# GEMINI_BASE_URL=
# GROQ_BASE_URL=
# MISTRAL_BASE_URL=
# CLOUDFLARE_BASE_URL=
# NVIDIA_BASE_URL=
# TOGETHER_BASE_URL=
# CEREBRAS_BASE_URL=
# DEEPINFRA_BASE_URL=
# GITHUB_MODELS_BASE_URL=
