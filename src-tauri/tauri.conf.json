{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberClergy",
  "version": "1.0.0",
  "identifier": "com.cyberclergy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberClergy",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CyberClergy",
    "copyright": "MIT licensed. Copyright (c) 2026 WertopHop.",
    "category": "Lifestyle",
    "shortDescription": "Free AI clergy that prays for you, continuously.",
    "longDescription": "CyberClergy stands a cloud of little robots on free AI models. Each one composes prayers from the tradition you choose, on the network you give it a key for, and keeps going while you live your life.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
